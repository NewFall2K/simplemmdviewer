{
  "name": "simplemmdviewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simple but advanced MMD (MikuMikuDance) viewer: folder PMX loading, VMD motion, look-at, breathing, random blinking and permanent/temporary morphs.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-ammo": "node scripts/sync-ammo.mjs",
    "predev": "npm run sync-ammo",
    "prebuild": "npm run sync-ammo",
    "postinstall": "node scripts/sync-ammo.mjs"
  },
  "dependencies": {
    "three": "0.171.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.171.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NewFall2K/simplemmdviewer.git"
  },
  "homepage": "https://github.com/NewFall2K/simplemmdviewer#readme",
  "bugs": {
    "url": "https://github.com/NewFall2K/simplemmdviewer/issues"
  }
}
